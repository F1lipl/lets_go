syntax = "v1"

info (
	title:   "Content Service"
	desc:    "Independent text and image posts; travel plans belong to TripServer"
	author:  "contentServer"
	version: "4.2"
)

type HealthResponse {
	Status string `json:"status"`
}

type ReadinessResponse {
	Status   string `json:"status"`
	Database string `json:"database"`
}

type CoverInput {
	AssetId   string  `json:"assetId,optional"`
	FocusX    float64 `json:"focusX,optional"`
	FocusY    float64 `json:"focusY,optional"`
	CropStyle string  `json:"cropStyle,optional"`
}

type CoverView {
	AssetId      string  `json:"assetId,optional"`
	FocusX       float64 `json:"focusX,optional"`
	FocusY       float64 `json:"focusY,optional"`
	CropStyle    string  `json:"cropStyle,optional"`
	Width        int64   `json:"width,optional"`
	Height       int64   `json:"height,optional"`
	ThumbnailUrl string  `json:"thumbnailUrl,optional"`
	LargeUrl     string  `json:"largeUrl,optional"`
}

type ContentBlock {
	BlockId       string   `json:"blockId"`
	ParentBlockId string   `json:"parentBlockId,optional"`
	BlockType     string   `json:"blockType"`
	SortOrder     int64    `json:"sortOrder"`
	Title         string   `json:"title,optional"`
	Text          string   `json:"text,optional"`
	AssetIds      []string `json:"assetIds,optional"`
}

type PostDocument {
	SchemaVersion uint32         `json:"schemaVersion"`
	Blocks        []ContentBlock `json:"blocks"`
}

type MediaAssetView {
	AssetId      string `json:"assetId"`
	MimeType     string `json:"mimeType"`
	Status       string `json:"status"`
	Width        int64  `json:"width"`
	Height       int64  `json:"height"`
	ThumbnailUrl string `json:"thumbnailUrl"`
	LargeUrl     string `json:"largeUrl"`
}

type PostTag {
	Id   string `json:"id"`
	Name string `json:"name"`
}

type CreatePostRequest {
	Visibility string       `json:"visibility"`
	Title      string       `json:"title,optional"`
	Summary    string       `json:"summary,optional"`
	Cover      CoverInput   `json:"cover,optional"`
	Document   PostDocument `json:"document"`
	TagNames   []string     `json:"tagNames,optional"`
}

type CreatePostData {
	PostId       string `json:"postId"`
	Status       string `json:"status"`
	PostVersion  uint64 `json:"postVersion"`
	DraftVersion uint64 `json:"draftVersion"`
	CreatedAt    string `json:"createdAt"`
}

type CreatePostResponse {
	ErrorCode int            `json:"errorCode"`
	Message   string         `json:"message"`
	Data      CreatePostData `json:"data,omitempty"`
	RequestId string         `json:"requestId,omitempty"`
}

type GetPostDraftRequest {
	PostId string `path:"postId"`
}

type GetPostDraftData {
	PostId       string           `json:"postId"`
	Status       string           `json:"status"`
	Visibility   string           `json:"visibility"`
	Title        string           `json:"title"`
	Summary      string           `json:"summary"`
	HasCover     bool             `json:"hasCover"`
	Cover        CoverView        `json:"cover"`
	Document     PostDocument     `json:"document"`
	MediaAssets  []MediaAssetView `json:"mediaAssets"`
	TagNames     []string         `json:"tagNames"`
	PostVersion  uint64           `json:"postVersion"`
	DraftVersion uint64           `json:"draftVersion"`
	UpdatedAt    string           `json:"updatedAt"`
}

type GetPostDraftResponse {
	ErrorCode int              `json:"errorCode"`
	Message   string           `json:"message"`
	Data      GetPostDraftData `json:"data,omitempty"`
	RequestId string           `json:"requestId,omitempty"`
}

type SavePostDraftRequest {
	PostId string `path:"postId"`
	// Save uses optimistic concurrency. A retry with an old version conflicts.
	ExpectedDraftVersion uint64       `json:"expectedDraftVersion"`
	Title                string       `json:"title,optional"`
	Summary              string       `json:"summary,optional"`
	Cover                CoverInput   `json:"cover,optional"`
	Document             PostDocument `json:"document"`
	TagNames             []string     `json:"tagNames,optional"`
}

type SavePostDraftData {
	PostId       string `json:"postId"`
	DraftVersion uint64 `json:"draftVersion"`
	UpdatedAt    string `json:"updatedAt"`
}

type SavePostDraftResponse {
	ErrorCode int               `json:"errorCode"`
	Message   string            `json:"message"`
	Data      SavePostDraftData `json:"data,omitempty"`
	RequestId string            `json:"requestId,omitempty"`
}

type PublishPostRequest {
	PostId               string `path:"postId"`
	ExpectedPostVersion  uint64 `json:"expectedPostVersion"`
	ExpectedDraftVersion uint64 `json:"expectedDraftVersion"`
}

type PublishPostData {
	PostId         string `json:"postId"`
	RevisionId     string `json:"revisionId"`
	RevisionNumber uint64 `json:"revisionNumber"`
	Status         string `json:"status"`
	PostVersion    uint64 `json:"postVersion"`
	PublishedAt    string `json:"publishedAt"`
}

type PublishPostResponse {
	ErrorCode int             `json:"errorCode"`
	Message   string          `json:"message"`
	Data      PublishPostData `json:"data,omitempty"`
	RequestId string          `json:"requestId,omitempty"`
}

type ChangePostVisibilityRequest {
	PostId              string `path:"postId"`
	Visibility          string `json:"visibility"`
	ExpectedPostVersion uint64 `json:"expectedPostVersion"`
}

type ChangePostVisibilityData {
	PostId      string `json:"postId"`
	Visibility  string `json:"visibility"`
	PostVersion uint64 `json:"postVersion"`
	UpdatedAt   string `json:"updatedAt"`
}

type ChangePostVisibilityResponse {
	ErrorCode int                      `json:"errorCode"`
	Message   string                   `json:"message"`
	Data      ChangePostVisibilityData `json:"data,omitempty"`
	RequestId string                   `json:"requestId,omitempty"`
}

type DeletePostRequest {
	PostId              string `path:"postId"`
	ExpectedPostVersion uint64 `form:"expectedPostVersion"`
}

type DeletePostData {
	PostId      string `json:"postId"`
	Status      string `json:"status"`
	PostVersion uint64 `json:"postVersion"`
	DeletedAt   string `json:"deletedAt"`
}

type DeletePostResponse {
	ErrorCode int            `json:"errorCode"`
	Message   string         `json:"message"`
	Data      DeletePostData `json:"data,omitempty"`
	RequestId string         `json:"requestId,omitempty"`
}

type GetPostRequest {
	PostId string `path:"postId"`
}

type GetPostData {
	PostId         string           `json:"postId"`
	AuthorId       string           `json:"authorId"`
	Status         string           `json:"status"`
	Visibility     string           `json:"visibility"`
	RevisionId     string           `json:"revisionId"`
	RevisionNumber uint64           `json:"revisionNumber"`
	Title          string           `json:"title"`
	Summary        string           `json:"summary"`
	HasCover       bool             `json:"hasCover"`
	Cover          CoverView        `json:"cover"`
	Document       PostDocument     `json:"document"`
	MediaAssets    []MediaAssetView `json:"mediaAssets"`
	Tags           []PostTag        `json:"tags"`
	LikeCount      uint64           `json:"likeCount"`
	FavoriteCount  uint64           `json:"favoriteCount"`
	CommentCount   uint64           `json:"commentCount"`
	PostVersion    uint64           `json:"postVersion"`
	PublishedAt    string           `json:"publishedAt"`
}

type GetPostResponse {
	ErrorCode int         `json:"errorCode"`
	Message   string      `json:"message"`
	Data      GetPostData `json:"data,omitempty"`
	RequestId string      `json:"requestId,omitempty"`
}

type ListPostsRequest {
	Cursor string `form:"cursor,optional"`
	Limit  int64  `form:"limit,default=20,range=[1:30]"`
	TagId  string `form:"tagId,optional"`
}

type PublishedPostCard {
	PostId        string    `json:"postId"`
	RevisionId    string    `json:"revisionId"`
	AuthorId      string    `json:"authorId"`
	Visibility    string    `json:"visibility"`
	Title         string    `json:"title"`
	Summary       string    `json:"summary"`
	HasCover      bool      `json:"hasCover"`
	Cover         CoverView `json:"cover"`
	Tags          []PostTag `json:"tags"`
	LikeCount     uint64    `json:"likeCount"`
	FavoriteCount uint64    `json:"favoriteCount"`
	CommentCount  uint64    `json:"commentCount"`
	PostVersion   uint64    `json:"postVersion"`
	PublishedAt   string    `json:"publishedAt"`
}

type ListPostsData {
	Items      []PublishedPostCard `json:"items"`
	NextCursor string              `json:"nextCursor,optional"`
	HasMore    bool                `json:"hasMore"`
}

type ListPostsResponse {
	ErrorCode int           `json:"errorCode"`
	Message   string        `json:"message"`
	Data      ListPostsData `json:"data,omitempty"`
	RequestId string        `json:"requestId,omitempty"`
}

type ListMyPostsRequest {
	Cursor string `form:"cursor,optional"`
	Limit  int64  `form:"limit,default=20,range=[1:30]"`
	Status string `form:"status,optional"`
}

type CreatorPostCard {
	PostId                string    `json:"postId"`
	Title                 string    `json:"title"`
	Summary               string    `json:"summary"`
	HasCover              bool      `json:"hasCover"`
	Cover                 CoverView `json:"cover"`
	Status                string    `json:"status"`
	Visibility            string    `json:"visibility"`
	PostVersion           uint64    `json:"postVersion"`
	DraftVersion          uint64    `json:"draftVersion"`
	PublishedRevisionId   string    `json:"publishedRevisionId,optional"`
	HasUnpublishedChanges bool      `json:"hasUnpublishedChanges"`
	PublishedAt           string    `json:"publishedAt,optional"`
	UpdatedAt             string    `json:"updatedAt"`
}

type ListMyPostsData {
	Items      []CreatorPostCard `json:"items"`
	NextCursor string            `json:"nextCursor,optional"`
	HasMore    bool              `json:"hasMore"`
}

type ListMyPostsResponse {
	ErrorCode int             `json:"errorCode"`
	Message   string          `json:"message"`
	Data      ListMyPostsData `json:"data,omitempty"`
	RequestId string          `json:"requestId,omitempty"`
}

type BatchGetPostCardsRequest {
	PostIds []string `json:"postIds"`
}

type BatchGetPostCardsData {
	Items []PublishedPostCard `json:"items"`
}

type BatchGetPostCardsResponse {
	ErrorCode int                   `json:"errorCode"`
	Message   string                `json:"message"`
	Data      BatchGetPostCardsData `json:"data,omitempty"`
	RequestId string                `json:"requestId,omitempty"`
}

type CreateImageUploadRequest {
	FileName    string `json:"fileName"`
	MimeType    string `json:"mimeType"`
	FileSize    uint64 `json:"fileSize"`
	ContentHash string `json:"contentHash,optional"`
}

type CreateImageUploadData {
	AssetId   string `json:"assetId"`
	Status    string `json:"status"`
	UploadUrl string `json:"uploadUrl"`
	ExpiresAt string `json:"expiresAt"`
}

type CreateImageUploadResponse {
	ErrorCode int                   `json:"errorCode"`
	Message   string                `json:"message"`
	Data      CreateImageUploadData `json:"data,omitempty"`
	RequestId string                `json:"requestId,omitempty"`
}

type CompleteImageUploadRequest {
	AssetId string `path:"assetId"`
}

type CompleteImageUploadData {
	Asset MediaAssetView `json:"asset"`
}

type CompleteImageUploadResponse {
	ErrorCode int                     `json:"errorCode"`
	Message   string                  `json:"message"`
	Data      CompleteImageUploadData `json:"data,omitempty"`
	RequestId string                  `json:"requestId,omitempty"`
}

type DeleteMediaAssetRequest {
	AssetId string `path:"assetId"`
}

type DeleteMediaAssetData {
	AssetId   string `json:"assetId"`
	Status    string `json:"status"`
	DeletedAt string `json:"deletedAt"`
}

type DeleteMediaAssetResponse {
	ErrorCode int                  `json:"errorCode"`
	Message   string               `json:"message"`
	Data      DeleteMediaAssetData `json:"data,omitempty"`
	RequestId string               `json:"requestId,omitempty"`
}

type SearchTagsRequest {
	Keyword string `form:"q"`
	Limit   int64  `form:"limit,default=20,range=[1:50]"`
}

type SearchTagsData {
	Items []PostTag `json:"items"`
}

type SearchTagsResponse {
	ErrorCode int            `json:"errorCode"`
	Message   string         `json:"message"`
	Data      SearchTagsData `json:"data,omitempty"`
	RequestId string         `json:"requestId,omitempty"`
}

@server (
	prefix: /api/v1
)
service content-api {
	@handler Health
	get /health returns (HealthResponse)

	@handler Readiness
	get /ready returns (ReadinessResponse)

	@handler ListPosts
	get /posts (ListPostsRequest) returns (ListPostsResponse)

	@handler GetPost
	get /posts/:postId (GetPostRequest) returns (GetPostResponse)

	@handler SearchTags
	get /tags/search (SearchTagsRequest) returns (SearchTagsResponse)
}

@server (
	prefix: /api/v1
	jwt:    Auth
)
service content-api {
	@handler CreatePost
	post /posts (CreatePostRequest) returns (CreatePostResponse)

	@handler BatchGetPostCards
	post /post-cards/batch (BatchGetPostCardsRequest) returns (BatchGetPostCardsResponse)

	@handler CreateImageUpload
	post /media/assets (CreateImageUploadRequest) returns (CreateImageUploadResponse)

	@handler CompleteImageUpload
	post /media/assets/:assetId/complete (CompleteImageUploadRequest) returns (CompleteImageUploadResponse)

	@handler DeleteMediaAsset
	delete /media/assets/:assetId (DeleteMediaAssetRequest) returns (DeleteMediaAssetResponse)

	@handler ListMyPosts
	get /me/posts (ListMyPostsRequest) returns (ListMyPostsResponse)

	@handler GetPostDraft
	get /posts/:postId/draft (GetPostDraftRequest) returns (GetPostDraftResponse)

	@handler SavePostDraft
	put /posts/:postId/draft (SavePostDraftRequest) returns (SavePostDraftResponse)

	@handler PublishPost
	post /posts/:postId/publish (PublishPostRequest) returns (PublishPostResponse)

	@handler ChangePostVisibility
	put /posts/:postId/visibility (ChangePostVisibilityRequest) returns (ChangePostVisibilityResponse)

	@handler DeletePost
	delete /posts/:postId (DeletePostRequest) returns (DeletePostResponse)
}
