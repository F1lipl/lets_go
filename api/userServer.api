syntax = "v1"

info (
	title:  "User Server API"
	desc:   "User register and login API"
	author: "F1lipl"
	email:  "c2995388076@163.com"
)

type (
	RegisterReq {
		UserName    string `json:"userName"`
		Password    string `json:"password"`
		PhoneNumber string `json:"phoneNumber"`
	}
	RegisterResp {
		ErrorCode int    `json:"errorCode"`
		Message   string `json:"message"`
		UserID    string `json:"userId,omitempty"`
	}
	GetVerificationReq {
		PhoneNumber string `json:"phoneNumber"`
	}
	GetVerificationResp {
		ErrorCode int    `json:"errorCode"`
		Message   string `json:"message"`
	}
	DeviceInfo {
		DeviceID   string `json:"deviceId,omitempty"`
		DeviceName string `json:"deviceName"`
		Platform   string `json:"platform"`
		AppVersion string `json:"appVersion"`
	}
	LoginByPhoneReq {
		PhoneNumber      string     `json:"phoneNumber"`
		VerificationCode string     `json:"verificationCode"`
		Device           DeviceInfo `json:"device"`
	}
	LoginByPasswordReq {
		IdentifierType string     `json:"identifierType"`
		Identifier     string     `json:"identifier"`
		Password       string     `json:"password"`
		Device         DeviceInfo `json:"device"`
	}
	LoginResp {
		ErrorCode   int    `json:"errorCode"`
		Message     string `json:"message"`
		DeviceID    string `json:"deviceId,omitempty"`
		AccessToken string `json:"accessToken,omitempty"`
	}
	RefreshResp {
		ErrorCode   int    `json:"errorCode"`
		Message     string `json:"message"`
		AccessToken string `json:"accessToken,omitempty"`
	}
	LogoutResp {
		ErrorCode int    `json:"errorCode"`
		Message   string `json:"message"`
	}
	UserInfoResp {
		ErrorCode int    `json:"errorCode"`
		Message   string `json:"message"`
		UserID    string `json:"userId"`
		Username  string `json:"username"`
		Nickname  string `json:"nickname"`
		AvatarURL string `json:"avatarUrl"`
	}
)

service userServer-api {
	@handler RegisterHandler
	post /register (RegisterReq) returns (RegisterResp)

	@handler VerificationHandler
	post /verification-code (GetVerificationReq) returns (GetVerificationResp)

	@handler LoginByPhoneHandler
	post /login/phone (LoginByPhoneReq) returns (LoginResp)

	@handler LoginByPasswordHandler
	post /login/password (LoginByPasswordReq) returns (LoginResp)

	@handler RefreshHandler
	post /refresh returns (RefreshResp)
}

@server (
	jwt: Auth
)
service userServer-api {
	@handler UserInfoHandler
	get /me returns (UserInfoResp)

	@handler LogoutHandler
	post /logout returns (LogoutResp)
}

